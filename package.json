{
  "dependencies": {
    "express": "*",
    "socket.io": "*"
  },
  "scripts": {
    "start": "node server.js",
    "test": "mocha",
    "test:unit": "mocha",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:all": "mocha && jest tests/integration --runInBand --detectOpenHandles --forceExit && playwright test --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "supertest": "^7.3.1"
  }
}
